generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  phone                 String?
  avatar                String?
  role                  String         @default("USER")
  createdAt             DateTime       @default(now())
  listings              Listing[]
  favorites             Favorite[]
  conversationsAsBuyer  Conversation[] @relation("ConvBuyer")
  conversationsAsSeller Conversation[] @relation("ConvSeller")
  sentMessages          Message[]      @relation("MessageSender")
  reviewsGiven          Review[]       @relation("ReviewsGiven")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  reportsMade           Report[]       @relation("ReportsMade")
  savedSearches         SavedSearch[]
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  sellerId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, sellerId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  listingId  String
  reason     String
  createdAt  DateTime @default(now())
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([reporterId, listingId])
}

model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  name          String
  filters       String   @default("{}")
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id               String         @id @default(cuid())
  title            String
  brand            String
  model            String
  year             Int
  price            Float
  currency         String         @default("RON")
  mileage          Int
  fuelType         String
  transmission     String
  engineSize       Float?
  powerHp          Int?
  bodyType         String?
  color            String?
  vin              String?
  location         String
  description      String
  images           String         @default("[]")
  sellerId         String
  isFeatured       Boolean        @default(false)
  isPremium        Boolean        @default(false)
  status           String         @default("ACTIVE")
  views            Int            @default(0)
  driveType        String?
  doors            Int?
  seats            Int?
  emissionStandard String?
  isNegotiable     Boolean        @default(false)
  origin           String?
  expiresAt        DateTime?
  expiryWarningSent Boolean       @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  seller           User           @relation(fields: [sellerId], references: [id])
  favorites        Favorite[]
  conversations    Conversation[]
  reports          Report[]
  priceHistory     PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  price     Float
  currency  String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User      @relation("ConvBuyer", fields: [buyerId], references: [id])
  seller    User      @relation("ConvSeller", fields: [sellerId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
}
